# Keep the build context lean and reproducible.
target/
**/node_modules/
activity/dist/
data/
*.db
*.db-shm
*.db-wal
.git/
.github/
docs/
PLAN.md
.env
leaf.conf
# The local dev environment (scripts/dev-up): its settings, and its logs and
# pid files. leaf's dev log holds a setup code.
scripts/dev.env
.dev-run/
# Copies of real data (see .gitignore): never into a build layer or its cache.
*.tgz
*.tar.gz
walpurgis-export-*.json
leaf-export-*.json
**/.DS_Store
