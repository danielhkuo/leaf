  refute_file "$STATE/cloudflared.args"
  refute_file "$RUN/tunnel.pid"
  # A trailing slash on the public URL is not doubled.
  EXTRA_ENV=()
  up --no-build
  expect_rc 0
  expect_line "tunnel ok" "$PUBLIC/setup answers"
