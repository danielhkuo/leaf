  expect_log_tail_shown emulator
  refute_file "$RUN/emulator.pid"
  refute_file "$STATE/emulator.running"
  expect_alive "$(recorded_pid leaf)" "leaf"
  down --emulator
  expect_rc 0
  expect_line "emulator ok" "nothing to stop"
  expect_nothing_running
}

