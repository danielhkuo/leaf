#!/usr/bin/env bash
#
# scripts/tests/run: tests for scripts/dev-up, dev-down and dev-status.
#
# Each test copies the three scripts into a throwaway repository skeleton and
# runs them there against stand-ins (scripts/tests/stubs): a leaf that only
# speaks the addresses the scripts ask, a cloudflared that plays the public
# end of a tunnel on 127.0.0.1, an Android SDK whose emulator and adb are
# files, and an npm and a cargo that "build" in a millisecond. Nothing real
# is built, started or contacted, the ports are ones the system hands out,
# and the scripts run with an empty environment, so a real leaf, tunnel or
# emulator on this machine is never looked at.
#
#   scripts/tests/run                 every test
#   scripts/tests/run tunnel leaf     only the tests whose name has a word
#
#   TEST_BASH=/path/to/bash   run the scripts with that bash (default: the
#                             one their `#!/usr/bin/env bash` finds)
#   TEST_SHOW=1               print what each run of a script printed
#   DEV_SCRIPTS_SRC=dir       test the scripts in that directory instead
#
# Needs python3 (the stand-in servers) and curl. No test sleeps or reads the
# clock: a stand-in changes its answer after a set number of questions or
# when a file appears, and where a test starts a process itself it waits for
# a line on a fifo, or for a file the scripts write (`wait_until`).

set -u

HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
SRC=${DEV_SCRIPTS_SRC:-$HERE/..}
SRC=$(cd "$SRC" && pwd)
STUBS=$HERE/stubs

for tool in python3 curl; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "scripts/tests/run needs $tool, which was not found on PATH." >&2
    exit 2
  }
done
PYTHON=$(command -v python3)
if [ -n "${TEST_BASH:-}" ]; then
  TEST_BASH=$(command -v "$TEST_BASH") || {
    echo "scripts/tests/run: TEST_BASH names no program." >&2
    exit 2
  }
fi

# The scripts run in a UTF-8 locale when the machine has one, as they do in a
# terminal: bash 3.2 reads "$name” differently there than in the C locale.
UTF8_LOCALE=C
for candidate in en_US.UTF-8 C.UTF-8 $(locale -a 2>/dev/null | grep -i 'utf-\{0,1\}8$' | head -n 1); do
  if locale -a 2>/dev/null | grep -qx "$candidate"; then
    UTF8_LOCALE=$candidate
    break
  fi
done

TESTS_RUN=0
TESTS_FAILED=0
TEST_NAME=
TEST_OK=1
SANDBOXES=()

# ---------------------------------------------------------------- checks

fail() {
  if [ "$TEST_OK" -eq 1 ]; then
    printf 'FAIL  %s\n' "$TEST_NAME"
  fi
  TEST_OK=0
  printf '      %s\n' "$*"
}

# Shows the output a failed check was about, once per run of a script.
show_output() {
  printf '      ---- exit status %s, output:\n' "$RC"
  printf '%s\n' "$OUT" | sed 's/^/      | /'
}

expect_rc() {
  [ "$RC" -eq "$1" ] && return 0
  fail "expected exit status $1, got $RC"
  show_output
}

expect_out() {
  case $OUT in
  *"$1"*) return 0 ;;
  esac
  fail "expected the output to contain: $1"
  show_output
}

refute_out() {
  case $OUT in
  *"$1"*)
    fail "expected the output not to contain: $1"
    show_output
    ;;
  esac
}

# The output has a line that starts with the first argument (a step's name
# and result, whatever the spacing) and contains the second.
expect_line() {
  local line want_start=$1 want_text=${2:-} squeezed
  while IFS= read -r line; do
    squeezed=$(printf '%s' "$line" | tr -s ' ')
    case $squeezed in
    "$want_start"*"$want_text"*) return 0 ;;
    esac
  done <<EOF
$OUT
EOF
  fail "expected a line starting “${want_start}” that contains: $want_text"
  show_output
}

refute_line() {
  local line squeezed
  while IFS= read -r line; do
    squeezed=$(printf '%s' "$line" | tr -s ' ')
    case $squeezed in
    "$1"*)
      fail "expected no line starting “${1}”"
      show_output
      return 0
      ;;
    esac
  done <<EOF
$OUT
EOF
}

# The output shows the end of NAME.log as that log now is: its last lines
# under "last lines of", or the line that says it is empty. For a process the
# script has just stopped, whose log is therefore complete. How far a
# stand-in got before it was stopped is not this check's business, so no
# race with its start decides the result.
expect_log_tail_shown() {
  local log=$RUN/$1.log line
  if [ ! -s "$log" ]; then
    expect_out "(nothing was written to .dev-run/$1.log)"
    return 0
  fi
  expect_out "last lines of .dev-run/$1.log:"
  while IFS= read -r line; do
    expect_out "| $line"
  done <<EOF
$(tail -n 15 "$log")
EOF
}

expect_file() { [ -e "$1" ] || fail "expected $1 to exist"; }
refute_file() { [ ! -e "$1" ] || fail "expected $1 not to exist"; }

expect_content() {
  local content
  content=$(cat "$1" 2>/dev/null) || {
    fail "expected $1 to exist and hold: $2"
    return 0
  }
  case $content in
  *"$2"*) ;;
  *) fail "expected $1 to hold “${2}”, but it holds: $content" ;;
  esac
}

alive() {
  local stat
  kill -0 "$1" 2>/dev/null || return 1
  stat=$(ps -o stat= -p "$1" 2>/dev/null) || return 1
  case $stat in
  '' | Z*) return 1 ;;
  esac
  return 0
}

expect_alive() { alive "$1" || fail "expected ${2:-the process} (pid $1) to be running"; }
expect_dead() { alive "$1" && fail "expected ${2:-the process} (pid $1) to have stopped"; }

# The pids of processes whose command line mentions this test's directory:
# everything a test started, and nothing else on the machine.
sandbox_pids() {
  local pid cmd
  # Only ever a directory `sandbox` made: with anything shorter, the match
  # below would take in processes that are not a test's.
  case ${T:-} in
  */leaf-dev-test.??????) ;;
  *) return 0 ;;
  esac
  ps -Aww -o pid=,command= 2>/dev/null | while read -r pid cmd; do
    case $cmd in
    *"$T"*) printf '%s\n' "$pid" ;;
    esac
  done
}

expect_nothing_running() {
  local pids
  pids=$(sandbox_pids | tr '\n' ' ')
  [ -z "$pids" ] || fail "expected nothing of this test's to be running, but found: $pids"
}

# ---------------------------------------------------------------- sandbox

free_port() {
  "$PYTHON" -c 'import socket
s = socket.socket()
s.bind(("127.0.0.1", 0))
print(s.getsockname()[1])'
}

# A fresh repository skeleton in $T with the scripts under test in it, a
# leaf already "built", and settings in scripts/dev.env.
sandbox() {
  T=$(mktemp -d "${TMPDIR:-/tmp}/leaf-dev-test.XXXXXX")
  T=$(cd "$T" && pwd -P)
  SANDBOXES+=("$T")
  REPO=$T/repo
  RUN=$REPO/.dev-run
  STATE=$T/state
  DATA=$T/data
  mkdir -p "$REPO/scripts" "$REPO/activity/node_modules" "$REPO/activity/dist" \
    "$REPO/target/debug" "$T/bin" "$T/sdk/emulator" "$T/sdk/platform-tools" \
    "$STATE" "$T/home"
  cp "$SRC/dev-up" "$SRC/dev-down" "$SRC/dev-status" "$SRC/dev-lib.sh" "$REPO/scripts/"
  echo "<title>leaf</title>" >"$REPO/activity/dist/index.html"
  cp "$STUBS/leaf" "$REPO/target/debug/leaf"
  cp "$STUBS/npm" "$STUBS/cargo" "$STUBS/leaf" "$STUBS/cloudflared" "$T/bin/"
  cp "$STUBS/emulator" "$T/sdk/emulator/emulator"
  cp "$STUBS/adb" "$T/sdk/platform-tools/adb"
  ln -s "$PYTHON" "$T/bin/python3"
  PORT=$(free_port)
  TUNNEL_PORT=$(free_port)
  # A name no other run of this file has: an emulator "started by hand" is
  # looked for by its AVD's name, among every process on the machine.
  AVD=stub-avd-${T##*.}
  PUBLIC=http://127.0.0.1:$TUNNEL_PORT
  LOCAL=http://127.0.0.1:$PORT
  cat >"$REPO/scripts/dev.env" <<EOF
LEAF_DEV_PORT=$PORT
LEAF_DEV_DATA_DIR=$DATA
EOF
  # What every run of a script gets, and nothing from the caller's own
  # environment. The stand-ins come first on PATH.
  BASE_ENV=(
    "HOME=$T/home"
    "LC_ALL=$UTF8_LOCALE"
    "PATH=$T/bin:/usr/bin:/bin:/usr/sbin:/sbin"
    "STUB_STATE=$STATE"
    "STUB_TUNNEL_PORT=$TUNNEL_PORT"
    "STUB_TUNNEL_ORIGIN=127.0.0.1:$PORT"
  )
  EXTRA_ENV=()
}

# Adds the settings a tunnel needs to the sandbox's dev.env.
with_tunnel() {
  printf 'tunnel: stub-tunnel\ningress:\n  - hostname: leaf-local.example.com\n    service: http://localhost:%s\n  - service: http_status:404\n' \
    "$PORT" >"$T/tunnel.yml"
  cat >>"$REPO/scripts/dev.env" <<EOF
LEAF_DEV_TUNNEL_CONFIG=$T/tunnel.yml
LEAF_DEV_TUNNEL_NAME=stub-tunnel
LEAF_DEV_PUBLIC_URL=$PUBLIC
LEAF_DEV_CLOUDFLARED=$T/bin/cloudflared
EOF
}

with_emulator() {
  cat >>"$REPO/scripts/dev.env" <<EOF
LEAF_DEV_AVD=$AVD
ANDROID_HOME=$T/sdk
EOF
}

# Runs one of the scripts in the sandbox. Sets OUT (stdout and stderr) and RC.
script() {
  local name=$1
  shift
  if [ -n "${TEST_BASH:-}" ]; then
    OUT=$(env -i "${BASE_ENV[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} \
      "$TEST_BASH" "$REPO/scripts/$name" "$@" 2>&1)
  else
    OUT=$(env -i "${BASE_ENV[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} \
      "$REPO/scripts/$name" "$@" 2>&1)
  fi
  RC=$?
  if [ -n "${TEST_SHOW:-}" ]; then
    printf '$ scripts/%s %s\n%s\n[exit status %s]\n\n' "$name" "$*" "$OUT" "$RC"
  fi
}

up() { script dev-up "$@"; }
down() { script dev-down "$@"; }
status() { script dev-status "$@"; }

recorded_pid() { head -n 1 "$RUN/$1.pid" 2>/dev/null; }

# Runs one of the scripts in the background the way a terminal runs a command:
# in a process group of its own, with SIGINT and SIGHUP not ignored (they are
# when this file itself was started in the background, or under nohup, and a
# shell cannot give an ignored signal back to what it starts; python can).
# Sets BG to its pid, which is also its process group's id. `finish` waits for
# it to end and sets OUT and RC as `script` does.
AS_FROM_A_TERMINAL='import os, signal, sys
signal.signal(signal.SIGINT, signal.SIG_DFL)
signal.signal(signal.SIGHUP, signal.SIG_DFL)
os.execv(sys.argv[1], sys.argv[1:])'

script_bg() {
  local name=$1
  shift
  # The braces: see dev_spawn in dev-lib.sh, which starts things the same way.
  set -m
  if [ -n "${TEST_BASH:-}" ]; then
    { env -i "${BASE_ENV[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} "$PYTHON" -c "$AS_FROM_A_TERMINAL" \
      "$TEST_BASH" "$REPO/scripts/$name" "$@" >"$T/bg.out" 2>&1 </dev/null & } 2>/dev/null
  else
    { env -i "${BASE_ENV[@]}" ${EXTRA_ENV[@]+"${EXTRA_ENV[@]}"} "$PYTHON" -c "$AS_FROM_A_TERMINAL" \
      "$REPO/scripts/$name" "$@" >"$T/bg.out" 2>&1 </dev/null & } 2>/dev/null
  fi
  BG=$!
  set +m
  BG_NAME="$name $*"
}

gone() { ! alive "$1"; }

finish() {
  # It ends by itself; a script that never would is ended here, and that is
  # a failure.
  if ! wait_until gone "$BG"; then
    kill -KILL "$BG" 2>/dev/null
  fi
  wait "$BG"
  RC=$?
  OUT=$(cat "$T/bg.out")
  if [ -n "${TEST_SHOW:-}" ]; then
    printf '$ scripts/%s &\n%s\n[exit status %s]\n\n' "$BG_NAME" "$OUT" "$RC"
  fi
}

# What Ctrl-C does: SIGINT to every process in the foreground process group.
ctrl_c() { kill -s INT -- "-$1"; }

# Spins until a command succeeds. Neither a sleep nor the clock decides the
# result: the limit only ends a run in which it never would.
wait_until() {
  local limit=$((SECONDS + 60))
  until "$@"; do
    if [ "$SECONDS" -ge "$limit" ]; then
      fail "gave up waiting for: $*"
      return 1
    fi
  done
}

# Whether NAME.info in the runtime directory has a line for KEY, and whether
# NAME.log has a line containing TEXT.
info_has() { grep -q "^$2=" "$RUN/$1.info" 2>/dev/null; }
log_has() { grep -qF -- "$2" "$RUN/$1.log" 2>/dev/null; }

# The id of a process's process group.
pgid_of() { ps -o pgid= -p "$1" 2>/dev/null | tr -d ' '; }

# Starts a stand-in outside dev-up (something "started by hand") and waits
# until it is ready. Sets BYSTANDER to its pid.
#   bystander COMMAND [ARG...]   (extra environment in BYSTANDER_ENV)
bystander() {
  local fifo=$T/ready.$RANDOM line=
  mkfifo "$fifo"
  env -i "${BASE_ENV[@]}" ${BYSTANDER_ENV[@]+"${BYSTANDER_ENV[@]}"} "STUB_READY_FIFO=$fifo" \
    "$@" >"$T/bystander.log" 2>&1 </dev/null &
  BYSTANDER=$!
  disown "$BYSTANDER" 2>/dev/null
  # Opened for reading and writing so the open itself cannot block. The
  # time limit is not a wait: it only ends a run whose stand-in never started.
  exec 3<>"$fifo"
  IFS= read -r -t 30 line <&3
  exec 3<&-
  rm -f "$fifo"
  [ "$line" = ready ] || fail "the stand-in ($*) did not start: $(cat "$T/bystander.log" 2>/dev/null)"
}

# Ends a bystander for good; the test is over with it.
end_bystander() {
  kill -KILL "$1" 2>/dev/null
  while alive "$1"; do :; done
}

# Stops whatever a test left behind, so a failed test does not leak processes.
sweep() {
  local dir pid
  for dir in ${SANDBOXES[@]+"${SANDBOXES[@]}"}; do
    T=$dir
    for pid in $(sandbox_pids); do
      kill -KILL "$pid" 2>/dev/null
    done
    case $dir in
    */leaf-dev-test.??????) rm -rf "$dir" ;;
    esac
  done
  SANDBOXES=()
}
trap sweep EXIT

# ---------------------------------------------------------------- tests

test_scripts_parse() {
  local file shell
  for shell in /bin/bash "${TEST_BASH:-bash}"; do
    command -v "$shell" >/dev/null 2>&1 || continue
    for file in "$SRC/dev-up" "$SRC/dev-down" "$SRC/dev-status" "$SRC/dev-lib.sh" \
      "$HERE/run" "$STUBS/adb" "$STUBS/npm" "$STUBS/cargo"; do
      "$shell" -n "$file" 2>/dev/null || fail "$shell -n $file reports a syntax error"
    done
  done
  for file in dev-up dev-down dev-status; do
    [ -x "$SRC/$file" ] || fail "scripts/$file is not executable"
  done
  [ -x "$HERE/run" ] || fail "scripts/tests/run is not executable"
}

test_setup_mode_up_status_down() {
  local pid
  sandbox
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "gallery skip" "--no-build: serving the build in activity/dist"
  expect_line "binary skip" "--no-build: starting target/debug/leaf"
  expect_line "leaf ok" "setup mode on $LOCAL (pid "
  expect_out "setup code: TEST-C0DE"
  expect_out "open http://localhost:$PORT/setup and enter it"
  expect_line "tunnel skip" "--no-tunnel"
  refute_line "emulator"
  refute_line "gateway"
  pid=$(recorded_pid leaf)
  expect_alive "$pid" "leaf"
  expect_line "leaf ok" "(pid $pid)"
  # What leaf was started with: loopback only, the data and gallery
  # directories, plain-text logs, from the repository root.
  expect_content "$STATE/leaf.env" "BIND_ADDR=127.0.0.1:$PORT"
  expect_content "$STATE/leaf.env" "DATA_DIR=$DATA"
  expect_content "$STATE/leaf.env" "STATIC_DIR=$REPO/activity/dist"
  expect_content "$STATE/leaf.env" "NO_COLOR=1"
  expect_content "$STATE/leaf.env" "LOG_LEVEL=<unset>"
  expect_content "$STATE/leaf.env" "DEV_GUILD_ID=<unset>"
  expect_content "$STATE/leaf.env" "cwd=$REPO"
  expect_file "$RUN/leaf.log"
  refute_file "$RUN/lock"
  # The log holds the setup code, so the directory is this account's only.
  [ -n "$(find "$RUN" -maxdepth 0 -perm 700)" ] ||
    fail "expected $RUN to be readable by its owner only: $(ls -ld "$RUN")"

  status
  expect_rc 0
  expect_line "leaf running" "setup mode on $LOCAL (pid $pid)"
  expect_out "log: .dev-run/leaf.log"
  expect_out "setup code: TEST-C0DE"
  expect_line "tunnel stopped" "LEAF_DEV_TUNNEL_CONFIG is not set"
  refute_line "emulator"
  expect_out "Next: open http://localhost:$PORT/setup, enter the setup code and fill in the form."

  down
  expect_rc 0
  expect_line "tunnel ok" "nothing to stop"
  expect_line "leaf ok" "stopped (pid $pid)"
  expect_dead "$pid" "leaf"
  refute_file "$RUN/leaf.pid"
  refute_file "$RUN/leaf.info"
  refute_file "$RUN/lock"
  expect_content "$RUN/leaf.log" "shut down cleanly"

  status
  expect_rc 1
  expect_line "leaf stopped" "scripts/dev-up starts it"
  expect_out "Next: scripts/dev-up"
  expect_nothing_running
}

test_up_twice_starts_one_leaf() {
  local pid
  sandbox
  up --no-build --no-tunnel
  expect_rc 0
  pid=$(recorded_pid leaf)
  # A second run must not reach the build either.
  EXTRA_ENV=(STUB_NPM=fail STUB_CARGO=fail)
  up
  expect_rc 0
  expect_line "leaf ok" "already running: setup mode on $LOCAL (pid $pid)"
  expect_out "to rebuild and restart it: scripts/dev-down, then scripts/dev-up"
  expect_out "setup code: TEST-C0DE"
  refute_line "gallery"
  refute_file "$STATE/npm.args"
  [ "$(recorded_pid leaf)" = "$pid" ] || fail "the second run recorded another pid"
  [ "$(sandbox_pids | wc -l | tr -d ' ')" = 1 ] || fail "expected exactly one process, found: $(sandbox_pids | tr '\n' ' ')"

  down
  expect_rc 0
  down
  expect_rc 0
  expect_line "leaf ok" "nothing to stop"
  expect_nothing_running
}

test_run_mode_reports_the_gateway() {
  local pid
  sandbox
  # Two answers say `starting` before the bot is online.
  EXTRA_ENV=(STUB_LEAF=run STUB_GATEWAY_STARTING=2)
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "leaf ok" "run mode on $LOCAL (pid "
  expect_line "gateway ok" "online"
  refute_out "setup code"
  pid=$(recorded_pid leaf)

  status
  expect_rc 0
  expect_line "leaf running" "run mode on $LOCAL (pid $pid)"
  expect_line "gateway online"
  # No tunnel, so the doctor is pointed at this leaf, and at its data dir.
  # (Quoted for the shell, should the path need it.)
  expect_out "Next: DATA_DIR=$(printf '%q' "$DATA") cargo run -p leaf -- doctor --url $LOCAL"
  expect_out "then asks this leaf directly, since no tunnel answers)"

  down
  expect_rc 0
  expect_nothing_running
}

test_a_proxy_in_the_environment_is_not_asked_about_this_machine() {
  sandbox
  # A proxy nothing listens on: a request sent through it gets no answer.
  EXTRA_ENV=(STUB_LEAF=run "http_proxy=http://127.0.0.1:1" "all_proxy=http://127.0.0.1:1")
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "leaf ok" "run mode on $LOCAL (pid "
  expect_line "gateway ok" "online"
  status
  expect_rc 0
  expect_line "leaf running" "run mode"
  expect_line "gateway online"
  down
  expect_rc 0
  expect_nothing_running
}

test_gateway_error_is_a_failure_with_its_reason() {
  local pid
  sandbox
  EXTRA_ENV=(STUB_LEAF=run STUB_GATEWAY=error)
  up --no-build --no-tunnel
  expect_rc 1
  expect_line "leaf ok" "run mode"
  # The reason, with JSON's escapes undone.
  expect_line "gateway failed" 'the bot is not connected: Discord refused the bot token ("401 Unauthorized"). Path C:\leaf.'
  expect_out "notice: Discord has not accepted the command list yet."
  expect_out "last lines of .dev-run/leaf.log:"
  expect_out "Not everything is up."
  # leaf itself is up and stays up.
  pid=$(recorded_pid leaf)
  expect_alive "$pid" "leaf"

  status
  expect_rc 0
  expect_line "gateway error" 'Discord refused the bot token ("401 Unauthorized")'
  expect_out "notice: Discord has not accepted the command list yet."

  down
  expect_nothing_running
}

test_gateway_still_starting_is_a_failure() {
  sandbox
  EXTRA_ENV=(STUB_LEAF=run STUB_GATEWAY=starting LEAF_DEV_WAIT_GATEWAY=1)
  up --no-build --no-tunnel
  expect_rc 1
  expect_line "gateway failed" "still connecting to Discord after 1s"
  status
  expect_line "gateway starting"
  down
  expect_nothing_running
}

test_setup_code_hidden_by_the_log_level_is_said() {
  sandbox
  echo "LOG_LEVEL=warn" >>"$REPO/scripts/dev.env"
  up --no-build --no-tunnel
  expect_rc 0
  expect_content "$STATE/leaf.env" "LOG_LEVEL=warn"
  expect_line "leaf ok" "setup mode"
  refute_out "setup code:"
  expect_out "no setup code in .dev-run/leaf.log. leaf logs it at info level: unset LOG_LEVEL, then run scripts/dev-down and scripts/dev-up."
  down
  expect_nothing_running
}

test_port_held_by_something_else_is_an_error_not_a_kill() {
  local other
  sandbox
  BYSTANDER_ENV=("BIND_ADDR=127.0.0.1:$PORT")
  bystander "$T/bin/leaf"
  other=$BYSTANDER
  # With the build on: the port is checked before anything is built.
  up --no-tunnel
  expect_rc 1
  expect_line "leaf failed" "port $PORT is held by"
  expect_line "leaf failed" "(pid $other), which dev-up did not start. Stop it yourself, or use another port: scripts/dev-up --port N."
  refute_file "$STATE/npm.args"
  refute_file "$STATE/cargo.args"
  refute_file "$RUN/leaf.pid"
  refute_line "tunnel"
  expect_alive "$other" "the process that holds the port"

  status
  expect_rc 1
  expect_line "leaf stopped" "dev-up has not started it, but port $PORT is held by"
  expect_out "(pid $other)"
  # dev-up would only fail again: the next step is about the port.
  expect_out "Next: stop the process that holds port $PORT, or start leaf on another: scripts/dev-up --port N"
  refute_out "Next: scripts/dev-up"

  down
  expect_rc 0
  expect_line "leaf ok" "nothing to stop"
  expect_out "port $PORT is held by"
  expect_out "(pid $other), which dev-up did not start: left alone"
  expect_alive "$other" "the process that holds the port"

  end_bystander "$other"
  expect_nothing_running
}

test_leaf_that_exits_shows_its_log() {
  sandbox
  with_tunnel
  EXTRA_ENV=(STUB_LEAF=die)
  up --no-build
  expect_rc 1
  expect_line "leaf failed" "leaf exited before it answered on $LOCAL"
  expect_out "last lines of .dev-run/leaf.log:"
  expect_out "| Caused by: Address already in use (os error 48)"
  refute_file "$RUN/leaf.pid"
  refute_file "$RUN/leaf.info"
  # Nothing is started behind a leaf that is not there.
  refute_line "tunnel"
  refute_file "$STATE/cloudflared.args"
  refute_file "$RUN/lock"
  expect_nothing_running
}

test_leaf_that_died_later_is_said_and_started_again() {
  local first second
  sandbox
  up --no-build --no-tunnel
  expect_rc 0
  first=$(recorded_pid leaf)
  # It crashes some time after dev-up has gone.
  end_bystander "$first"

  status
  expect_rc 1
  expect_line "leaf stopped" "it has exited since dev-up started it. scripts/dev-up starts it again."
  expect_out "log: .dev-run/leaf.log"
  expect_out "Next: scripts/dev-up"

  up --no-build --no-tunnel
  expect_rc 0
  expect_line "leaf ok" "setup mode on $LOCAL (pid "
  refute_out "already running"
  second=$(recorded_pid leaf)
  [ "$second" != "$first" ] || fail "the pid of the leaf that died is still recorded"
  expect_alive "$second" "the new leaf"
  # The log of the run that died is kept beside the new one.
  expect_file "$RUN/leaf.log.1"
  down
  expect_rc 0
  expect_nothing_running
}

test_leaf_that_never_answers_is_stopped() {
  sandbox
  EXTRA_ENV=(STUB_LEAF=hang LEAF_DEV_WAIT_LEAF=1)
  up --no-build --no-tunnel
  expect_rc 1
  expect_line "leaf failed" "leaf did not answer on $LOCAL within 1s, so it was stopped"
  expect_log_tail_shown leaf
  refute_file "$RUN/leaf.pid"
  expect_nothing_running
}

test_port_flag_and_environment_override_the_file() {
  local second third pid
  sandbox
  second=$(free_port)
  third=$(free_port)
  up --no-build --no-tunnel --port "$second"
  expect_rc 0
  expect_line "leaf ok" "setup mode on http://127.0.0.1:$second"
  expect_content "$STATE/leaf.env" "BIND_ADDR=127.0.0.1:$second"
  pid=$(recorded_pid leaf)

  # dev-status and dev-down find it without being told the port.
  status
  expect_rc 0
  expect_line "leaf running" "setup mode on http://127.0.0.1:$second (pid $pid)"
  expect_out "Next: open http://localhost:$second/setup"

  # Asking for another port while it runs is said, not acted on.
  up --no-build --no-tunnel
  expect_rc 1
  expect_line "leaf failed" "leaf is already running on port $second (pid $pid), not $PORT. Run scripts/dev-down first to move it."
  expect_alive "$pid" "leaf"

  down
  expect_rc 0
  expect_dead "$pid" "leaf"

  # The environment beats dev.env; --port beats both.
  EXTRA_ENV=("LEAF_DEV_PORT=$third")
  up --no-build --no-tunnel
  expect_rc 0
  expect_content "$STATE/leaf.env" "BIND_ADDR=127.0.0.1:$third"
  down
  up --no-build --no-tunnel "--port=$second"
  expect_rc 0
  expect_content "$STATE/leaf.env" "BIND_ADDR=127.0.0.1:$second"
  down
  # Leading zeros are dropped: leaf gets the number.
  up --no-build --no-tunnel --port "00$second"
  expect_rc 0
  expect_line "leaf ok" "setup mode on http://127.0.0.1:$second (pid "
  expect_content "$STATE/leaf.env" "BIND_ADDR=127.0.0.1:$second"
  down
  expect_nothing_running
}

test_bad_command_lines() {
  sandbox
  up --port
  expect_rc 2
  expect_out "--port needs a port number."
  # An empty one is a missing one, not a reason to use the default.
  up --no-build --no-tunnel --port ""
  expect_rc 2
  expect_out "--port needs a port number."
  up --no-build --no-tunnel --port=
  expect_rc 2
  expect_out "--port needs a port number."
  up --port http
  expect_rc 2
  expect_out "the port must be a number from 1 to 65535, not “http”."
  up --port 70000
  expect_rc 2
  expect_out "the port must be a number from 1 to 65535, not “70000”."
  up --port 0
  expect_rc 2
  expect_out "not “0”."
  # Too long for the shell to compare as a number: still a sentence.
  up --port 99999999999999999999
  expect_rc 2
  expect_out "the port must be a number from 1 to 65535, not “99999999999999999999”."
  refute_out "integer expression"
  up --frobnicate
  expect_rc 2
  expect_out "“--frobnicate” is not an option."
  expect_out "Usage: scripts/dev-up"
  down --frobnicate
  expect_rc 2
  expect_out "Usage: scripts/dev-down"
  # A wait too long for the shell to count with is refused, not computed.
  EXTRA_ENV=(LEAF_DEV_WAIT_STOP=99999999999999999999)
  down
  expect_rc 2
  expect_out "LEAF_DEV_WAIT_STOP must be a whole number of seconds (at most 999999), not “99999999999999999999”."
  EXTRA_ENV=()
  status --frobnicate
  expect_rc 2
  up --help
  expect_rc 0
  expect_out "Usage: scripts/dev-up [--emulator] [--no-tunnel] [--no-build] [--port N]"
  down --help
  expect_rc 0
  status --help
  expect_rc 0
  refute_file "$RUN/leaf.pid"
  expect_nothing_running
}

test_settings_file_is_read_as_data() {
  sandbox
  mkdir -p "$T/home/leaf-data"
  cat >"$REPO/scripts/dev.env" <<EOF
# a comment, then a blank line

LEAF_DEV_PORT=$PORT   # a trailing comment
export LEAF_DEV_DATA_DIR="~/leaf-data"   # quoted, then a comment
  LOG_LEVEL='debug'   # the same with single quotes
DEV_GUILD_ID=900000000000000001
DISCORD_TOKEN=hunter2-value-sentinel
garbage-line-sentinel
aGVsbG8gd29ybGQgc2VudGluZWw=
LEAF_DEV_WAIT_LEAF=\$(touch $T/was-executed)
EOF
  up --no-build --no-tunnel
  # The last line is not a number of seconds: said, and nothing was run.
  expect_rc 2
  expect_out "LEAF_DEV_WAIT_LEAF must be a whole number of seconds"
  refute_file "$T/was-executed"

  # A number with a leading zero is that number, not an octal one.
  sed -i.bak '$d' "$REPO/scripts/dev.env"
  echo "LEAF_DEV_WAIT_LEAF=08" >>"$REPO/scripts/dev.env"
  up --no-build --no-tunnel
  expect_rc 0
  refute_out "value too great"
  expect_content "$STATE/leaf.env" "BIND_ADDR=127.0.0.1:$PORT"
  expect_content "$STATE/leaf.env" "DATA_DIR=$T/home/leaf-data"
  expect_content "$STATE/leaf.env" "LOG_LEVEL=debug"
  expect_content "$STATE/leaf.env" "DEV_GUILD_ID=900000000000000001"
  # A name these scripts do not read is named; its value never is, and a line
  # that is not a setting is only counted.
  expect_out "line 7 sets DISCORD_TOKEN, which these scripts do not read; ignored"
  expect_out "line 8 is not NAME=value; ignored"
  expect_out "line 9 is not NAME=value; ignored"
  refute_out "hunter2-value-sentinel"
  refute_out "garbage-line-sentinel"
  refute_out "aGVsbG8gd29ybGQgc2VudGluZWw"

  status
  expect_rc 0
  # The doctor needs the same two settings leaf got.
  expect_out "open http://localhost:$PORT/setup"
  down
  expect_nothing_running
}

test_doctor_command_carries_the_settings() {
  sandbox
  with_tunnel
  echo "DEV_GUILD_ID=900000000000000001" >>"$REPO/scripts/dev.env"
  EXTRA_ENV=(STUB_LEAF=run)
  up --no-build
  expect_rc 0
  status
  expect_rc 0
  # The tunnel answers, so the doctor asks the public URL in leaf.conf.
  expect_out "Next: DATA_DIR=$(printf '%q' "$DATA") DEV_GUILD_ID=900000000000000001 cargo run -p leaf -- doctor --url"
  refute_out "doctor --url http"
  expect_out "then asks the Public URL, the way Discord reaches it)"
  down
  # With the default data directory there is nothing to add.
  sed -i.bak '/LEAF_DEV_DATA_DIR/d;/DEV_GUILD_ID/d' "$REPO/scripts/dev.env"
  up --no-build
  expect_rc 0
  expect_content "$STATE/leaf.env" "DATA_DIR=$REPO/data"
  status
  expect_out "Next: cargo run -p leaf -- doctor --url"
  down
  expect_nothing_running
}

