}

test_down_never_signals_a_pid_that_is_not_dev_ups() {
  local leaf other
  sandbox
  up --no-build --no-tunnel
  expect_rc 0
  leaf=$(recorded_pid leaf)
  # The pid file now names some other process, as it would if leaf had died
  # and the system had handed its pid out again.
  cp "$STUBS/leaf" "$T/bin/bystander"
  BYSTANDER_ENV=("BIND_ADDR=127.0.0.1:$TUNNEL_PORT")
  bystander "$T/bin/bystander"
  other=$BYSTANDER
  echo "$other" >"$RUN/leaf.pid"

  status
  expect_rc 1
  expect_line "leaf stopped"

  down
  expect_rc 0
  expect_line "leaf ok" "nothing to stop: pid $other, which dev-up recorded, now belongs to"
  expect_out "and was left alone"
  expect_alive "$other" "the process that got the pid"
  refute_file "$RUN/leaf.pid"

  # The same when the record of what was started is gone.
  echo "$other" >"$RUN/leaf.pid"
  down
  expect_line "leaf ok" "nothing to stop: pid $other"
  expect_alive "$other" "the process that got the pid"

  # And dev-up does not take it for a running leaf either: it starts none on
  # a port that the real one (now unrecorded) still holds.
  echo "$other" >"$RUN/leaf.pid"
  echo "sig=$T/bin/not-this" >"$RUN/leaf.info"
  up --no-build --no-tunnel
  expect_rc 1
  expect_line "leaf failed" "port $PORT is held by"
  expect_alive "$other" "the process that got the pid"
  expect_alive "$leaf" "the unrecorded leaf"

  end_bystander "$other"
  end_bystander "$leaf"
  expect_nothing_running
}

test_stale_pid_file_is_forgotten() {
  local gone
  sandbox
  mkdir -p "$RUN"
  # A pid that is certainly not running: one that has just been reaped.
  true &
  gone=$!
  wait "$gone"
  echo "$gone" >"$RUN/leaf.pid"
  echo "sig=$REPO/target/debug/leaf" >"$RUN/leaf.info"
  status
  expect_rc 1
  expect_line "leaf stopped" "scripts/dev-up starts it"
  down
  expect_rc 0
  expect_line "leaf ok" "nothing to stop: it had already exited"
  refute_file "$RUN/leaf.pid"

  echo "$gone" >"$RUN/leaf.pid"
  echo "not-a-pid" >"$RUN/tunnel.pid"
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "leaf ok" "setup mode"
  [ "$(recorded_pid leaf)" != "$gone" ] || fail "the stale pid is still recorded"
  down
  expect_rc 0
  refute_file "$RUN/tunnel.pid"
  expect_nothing_running
}

test_down_kills_what_ignores_sigterm() {
  local leaf
  sandbox
  EXTRA_ENV=(STUB_IGNORE_TERM=leaf LEAF_DEV_WAIT_STOP=1)
  up --no-build --no-tunnel
  expect_rc 0
  leaf=$(recorded_pid leaf)
  down
  expect_rc 0
  expect_line "leaf ok" "stopped (pid $leaf). It did not stop when asked, so after 1s it was killed."
  expect_dead "$leaf" "leaf"
  refute_file "$RUN/leaf.pid"
  expect_nothing_running
}

test_one_run_at_a_time() {
  local other gone
  sandbox
  mkdir -p "$RUN/lock"
  cp "$STUBS/leaf" "$T/bin/bystander"
  BYSTANDER_ENV=("BIND_ADDR=127.0.0.1:$TUNNEL_PORT")
  bystander "$T/bin/bystander"
  other=$BYSTANDER
  echo "$other" >"$RUN/lock/pid"
  up --no-build --no-tunnel
  expect_rc 1
  expect_out "another dev-up or dev-down is running (pid $other)"
  refute_file "$RUN/leaf.pid"
  down
  expect_rc 1
  expect_out "another dev-up or dev-down is running (pid $other)"
  # The other run's lock is not taken away by the refusal.
  expect_content "$RUN/lock/pid" "$other"
  end_bystander "$other"

  # A lock left by a run that was killed does not block the next one.
  true &
  gone=$!
  wait "$gone"
  echo "$gone" >"$RUN/lock/pid"
  up --no-build --no-tunnel
  expect_rc 0
  refute_file "$RUN/lock"
  down
  expect_rc 0
  refute_file "$RUN/lock"
  expect_nothing_running
}

test_runtime_dir_is_never_the_data_dir() {
  sandbox
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$DATA")
  up --no-build --no-tunnel
  expect_rc 2
  expect_out "the runtime directory ($DATA) must not be the data directory or inside it"
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$DATA/run")
  up --no-build --no-tunnel
  expect_rc 2
  refute_file "$DATA/run"
  # Another spelling of the data directory is still the data directory:
  # through `.` and `..`, before the directory exists and after.
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$T/./data")
  up --no-build --no-tunnel
  expect_rc 2
  expect_out "must not be the data directory or inside it"
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$DATA/logs/../run")
  up --no-build --no-tunnel
  expect_rc 2
  mkdir -p "$DATA"
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$T/home/../data")
  up --no-build --no-tunnel
  expect_rc 2
  expect_out "must not be the data directory or inside it"
  # Relative to the repository root, as dev.env's examples are written.
  EXTRA_ENV=(LEAF_DEV_DATA_DIR=data LEAF_DEV_RUN_DIR=./data)
  up --no-build --no-tunnel
  expect_rc 2
  expect_out "the runtime directory ($REPO/./data) must not be the data directory or inside it"
  refute_file "$REPO/data"
  # Through a symlink to it.
  ln -s "$DATA" "$T/link"
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$T/link")
  up --no-build --no-tunnel
  expect_rc 2
  expect_out "must not be the data directory or inside it"
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$T/link/run")
  status
  expect_rc 2
  down
  expect_rc 2
  # And where the file system ignores case (macOS by default), in another case.
  if [ -d "$T/DATA" ]; then
    EXTRA_ENV=("LEAF_DEV_RUN_DIR=$T/DATA/run")
    up --no-build --no-tunnel
    expect_rc 2
    expect_out "must not be the data directory or inside it"
  fi
  # None of those runs wrote anything into the data directory.
  [ -z "$(ls -A "$DATA")" ] || fail "expected $DATA to be empty, but it holds: $(ls -A "$DATA")"
  # Somewhere else is fine, and is where everything goes.
  EXTRA_ENV=("LEAF_DEV_RUN_DIR=$T/elsewhere")
  up --no-build --no-tunnel
  expect_rc 0
  expect_file "$T/elsewhere/leaf.pid"
  refute_file "$RUN"
  status
  expect_rc 0
  expect_out "log: $T/elsewhere/leaf.log"
  down
  expect_rc 0
  expect_nothing_running
}

test_nothing_secret_is_read_or_printed() {
  local all file pass
  sandbox
  with_tunnel
  with_emulator
  mkdir -p "$DATA"
  echo 'discord_token = "conf-value-sentinel"' >"$DATA/leaf.conf"
  # Twice. With leaf.conf readable, a script that opened it would have its
  # contents to print or to log, and none may show up anywhere. With it
  # unreadable, everything must still work: no script needs the file.
  for pass in readable unreadable; do
    chmod 600 "$DATA/leaf.conf"
    [ "$pass" = unreadable ] && chmod 000 "$DATA/leaf.conf"
    EXTRA_ENV=(STUB_LEAF=run DISCORD_TOKEN=env-value-sentinel R2_SECRET_ACCESS_KEY=env-value-sentinel)
    up --no-build --emulator
    expect_rc 0
    all=$OUT
    # Again, down the "already running" paths.
    up --no-build --emulator
    expect_rc 0
    all="$all$OUT"
    status
    expect_rc 0
    all="$all$OUT"
    down --emulator
    expect_rc 0
    all="$all$OUT"
    status
    expect_rc 1
    OUT="$all$OUT"
    refute_out "conf-value-sentinel"
    refute_out "env-value-sentinel"
    for file in "$RUN"/*; do
      [ -f "$file" ] || continue
      if grep -q -e "conf-value-sentinel" -e "env-value-sentinel" "$file"; then
        fail "$file holds a value it should never have seen ($pass leaf.conf)"
      fi
    done
  done
  chmod 600 "$DATA/leaf.conf"
  # No line of code names the file: the scripts have no reason to.
  for file in dev-up dev-down dev-status dev-lib.sh; do
    if grep -v '^[[:space:]]*#' "$SRC/$file" | grep -q 'leaf\.conf'; then
      fail "scripts/$file mentions leaf.conf outside a comment"
    fi
    # Nor does any line list the environment or the shell's variables.
    if grep -v '^[[:space:]]*#' "$SRC/$file" |
      grep -Eq '(^|[;&|[:space:]])(printenv|export -p|declare -[px]|env|set)[[:space:]]*($|[|>;])'; then
      fail "scripts/$file prints the environment"
    fi
  done
  expect_nothing_running
}

test_example_settings_file_is_complete_and_valid() {
  local key keys
  keys=$(sed -n '/^DEV_ENV_KEYS="/,/"$/p' "$SRC/dev-lib.sh" | sed -e 's/^DEV_ENV_KEYS="//' -e 's/"$//')
  [ -n "$keys" ] || fail "could not read the list of settings from dev-lib.sh"
  for key in $keys; do
    grep -Eq "^#? ?$key=" "$SRC/dev.env.example" || fail "dev.env.example does not document $key"
  done
  # Used as it is, and with every commented setting switched on, it loads
  # without a complaint.
  sandbox
  # Whatever the example names, this test looks only at its own port, tunnel
  # and SDK: the environment beats the file.
  EXTRA_ENV=("LEAF_DEV_PORT=$PORT" "LEAF_DEV_AVD=$AVD" "ANDROID_HOME=$T/sdk"
    "LEAF_DEV_TUNNEL_CONFIG=$T/tunnel.yml" "LEAF_DEV_PUBLIC_URL=$PUBLIC")
  cp "$SRC/dev.env.example" "$REPO/scripts/dev.env"
  status
  expect_rc 1
  refute_out "ignored"
  expect_line "leaf stopped" "scripts/dev-up starts it"
  sed -e 's/^# \([A-Z_]*=\)/\1/' "$SRC/dev.env.example" >"$REPO/scripts/dev.env"
  grep -q '^LEAF_DEV_WAIT_STOP=' "$REPO/scripts/dev.env" || fail "the commented settings were not switched on"
  status
  expect_rc 1
  refute_out "ignored"
  refute_out "must be"
  expect_line "leaf stopped" "scripts/dev-up starts it"
  expect_nothing_running
}

test_runtime_files_are_git_ignored() {
  local root=$SRC/..
  if ! git -C "$root" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    printf 'skip  %s (the scripts under test are not in a git checkout)\n' "$TEST_NAME"
    TEST_OK=skip
    return 0
  fi
  git -C "$root" check-ignore -q scripts/dev.env || fail "scripts/dev.env is not git-ignored"
  git -C "$root" check-ignore -q .dev-run/leaf.log || fail ".dev-run/ is not git-ignored"
  git -C "$root" check-ignore -q scripts/dev.env.example && fail "scripts/dev.env.example is git-ignored"
  git -C "$root" check-ignore -q scripts/dev-up && fail "scripts/dev-up is git-ignored"
  # Nor do they go into an image build: the Dockerfile copies the whole tree.
  grep -qx 'scripts/dev\.env' "$root/.dockerignore" || fail "scripts/dev.env is not in .dockerignore"
  grep -qx '\.dev-run/' "$root/.dockerignore" || fail ".dev-run/ is not in .dockerignore"
}

test_what_dev_up_starts_is_detached_from_the_terminal() {
  local leaf tunnel
  sandbox
  with_tunnel
  # As from a terminal, where SIGHUP is not ignored to begin with.
  script_bg dev-up --no-build
  finish
  expect_rc 0
  expect_line "tunnel ok"
  leaf=$(recorded_pid leaf)
  tunnel=$(recorded_pid tunnel)
  # Each leads a process group of its own, so the SIGINT that Ctrl-C sends to
  # the terminal's group (dev-up's now, the shell's later) does not reach it.
  [ "$(pgid_of "$leaf")" = "$leaf" ] ||
    fail "expected leaf (pid $leaf) to lead its own process group, but its group is $(pgid_of "$leaf")"
  [ "$(pgid_of "$tunnel")" = "$tunnel" ] ||
    fail "expected the tunnel (pid $tunnel) to lead its own process group, but its group is $(pgid_of "$tunnel")"
  [ "$(pgid_of "$leaf")" != "$BG" ] || fail "leaf is in dev-up's process group"
  # And it ignores SIGHUP, so closing the terminal does not end it.
  expect_content "$STATE/leaf.env" "SIGHUP=ignored"
  down
  expect_rc 0
  expect_nothing_running
}

test_ctrl_c_during_up_frees_the_lock_and_keeps_what_started() {
  local leaf
  sandbox
  # This leaf starts and never answers, so dev-up is waiting for it when
  # Ctrl-C arrives. The wait is long enough never to end on its own.
  EXTRA_ENV=(STUB_LEAF=hang LEAF_DEV_WAIT_LEAF=3600)
  script_bg dev-up --no-build --no-tunnel
  # The last thing dev-up records about leaf before it starts waiting, and
  # the line the stand-in logs once it is up and would act on a SIGINT.
  if ! wait_until info_has leaf data || ! wait_until log_has leaf "stub: never listening"; then
    kill -KILL "$BG" 2>/dev/null
    return 0
  fi
  leaf=$(recorded_pid leaf)
  ctrl_c "$BG"
  finish
  expect_rc 130
  expect_out "interrupted. What had started is still running: scripts/dev-status shows it, scripts/dev-down stops it."
  refute_out "Up."
  refute_file "$RUN/lock"
  # Ctrl-C was for dev-up. leaf is still there, and still on record.
  expect_alive "$leaf" "leaf"
  [ "$(recorded_pid leaf)" = "$leaf" ] || fail "leaf (pid $leaf) is no longer recorded"
  expect_content "$RUN/leaf.info" "sig=$REPO/target/debug/leaf"

  # So the next dev-down finds it and stops it.
  EXTRA_ENV=()
  down
  expect_rc 0
  expect_line "leaf ok" "stopped (pid $leaf)"
  expect_nothing_running
}

test_ctrl_c_during_down_frees_the_lock() {
  local leaf
  sandbox
  EXTRA_ENV=(STUB_IGNORE_TERM=leaf LEAF_DEV_WAIT_STOP=3600)
  up --no-build --no-tunnel
  expect_rc 0
  leaf=$(recorded_pid leaf)
  script_bg dev-down
  # dev-down has asked leaf to stop and is waiting for it to go.
  if ! wait_until log_has leaf "stub: SIGTERM ignored"; then
    kill -KILL "$BG" 2>/dev/null
    return 0
  fi
  ctrl_c "$BG"
  finish
  expect_rc 130
  expect_out "interrupted. scripts/dev-status shows what is still running."
  refute_file "$RUN/lock"
  expect_alive "$leaf" "leaf"
  [ "$(recorded_pid leaf)" = "$leaf" ] || fail "leaf (pid $leaf) is no longer recorded"

  EXTRA_ENV=(LEAF_DEV_WAIT_STOP=1)
  down
  expect_rc 0
  expect_line "leaf ok" "stopped (pid $leaf). It did not stop when asked, so after 1s it was killed."
  expect_nothing_running
}

test_down_looks_again_before_it_kills() {
  local leaf
  sandbox
  cp "$STUBS/leaf" "$T/bin/bystander"
  # Asked to stop, this leaf turns into another program under the same pid:
  # what it looks like when a process exits during the wait and the system
  # hands its pid to something else.
  EXTRA_ENV=("STUB_TERM_EXEC=$T/bin/bystander" LEAF_DEV_WAIT_STOP=1)
  up --no-build --no-tunnel
  expect_rc 0
  leaf=$(recorded_pid leaf)
  down
  expect_rc 0
  expect_line "leaf ok" "asked to stop (pid $leaf). After 1s that pid belongs to"
  expect_out "which was left alone."
  refute_out "it was killed"
  expect_alive "$leaf" "the process that has the pid now"
  refute_file "$RUN/leaf.pid"
  end_bystander "$leaf"
  expect_nothing_running
}

test_leaf_that_stops_answering_is_reported_and_left_running() {
  local leaf
  sandbox
  with_tunnel
  up --no-build --no-tunnel
  expect_rc 0
  leaf=$(recorded_pid leaf)
  # From here on the stand-in answers every request with 503.
  : >"$STATE/leaf.deaf"
  EXTRA_ENV=(LEAF_DEV_WAIT_LEAF=1)
  up --no-build
  expect_rc 1
  expect_line "leaf failed" "running (pid $leaf) but not answering on $LOCAL. scripts/dev-down, then scripts/dev-up, restarts it."
  expect_out "last lines of .dev-run/leaf.log:"
  # Reported, not stopped, and nothing is started behind it.
  expect_alive "$leaf" "leaf"
  [ "$(recorded_pid leaf)" = "$leaf" ] || fail "leaf (pid $leaf) is no longer recorded"
  refute_line "tunnel"
  refute_file "$STATE/cloudflared.args"

  status
  expect_rc 1
  expect_line "leaf failed" "running (pid $leaf) but not answering on $LOCAL"
  expect_out "log: .dev-run/leaf.log"
  # dev-up alone would say the same again.
  expect_out "Next: scripts/dev-down, then scripts/dev-up"
  expect_alive "$leaf" "leaf"

  down
  expect_rc 0
  expect_line "leaf ok" "stopped (pid $leaf)"
  expect_nothing_running
}

