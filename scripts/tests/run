}

test_tunnel_started_by_hand_is_used_and_left() {
  local other
  sandbox
  with_tunnel
  BYSTANDER_ENV=()
  bystander "$T/bin/cloudflared" tunnel --config "$T/tunnel.yml" run stub-tunnel
  other=$BYSTANDER
  rm -f "$STATE/cloudflared.args"
  up --no-build
  expect_rc 0
  expect_line "tunnel ok" "$PUBLIC/setup answers through a cloudflared that dev-up did not start (pid $other); dev-down will leave it running"
  refute_file "$RUN/tunnel.pid"
  refute_file "$STATE/cloudflared.args"

  status
  expect_line "tunnel running" "$PUBLIC/setup answers, through a cloudflared that dev-up did not start (pid $other)"

  down
  expect_rc 0
  expect_line "tunnel ok" "nothing to stop"
  expect_out "a cloudflared that dev-up did not start runs this tunnel (pid $other): left alone"
  expect_alive "$other" "the cloudflared started by hand"

  # With no leaf of dev-up's, the address is not asked and nothing is claimed.
  status
  expect_rc 1
  expect_line "tunnel running" "pid $other, through a cloudflared that dev-up did not start. $PUBLIC is not checked while the leaf dev-up starts is not answering."
  end_bystander "$other"
  expect_nothing_running
}

test_emulator_waits_for_boot() {
  local leaf emulator
  sandbox
  with_emulator
  echo 'LEAF_DEV_EMULATOR_ARGS=-no-snapshot-load -no-boot-anim' >>"$REPO/scripts/dev.env"
  # Android says it has booted the third time it is asked.
  EXTRA_ENV=(STUB_BOOT_AFTER=3)
  up --no-build --no-tunnel --emulator
  expect_rc 0
  # emulator-5552, another AVD that is already booted, is not mistaken for it.
  expect_line "emulator ok" "$AVD is booted on emulator-5554 (pid "
  expect_content "$STATE/emulator.args" "-avd $AVD -no-snapshot-load -no-boot-anim"
  expect_content "$STATE/emulator.env" "ANDROID_HOME=$T/sdk"
  expect_content "$STATE/adb.boot-polls" "3"
  leaf=$(recorded_pid leaf)
  emulator=$(recorded_pid emulator)
  expect_alive "$emulator" "the emulator"

  up --no-build --no-tunnel --emulator
  expect_rc 0
  expect_line "emulator ok" "already running: $AVD is booted on emulator-5554 (pid $emulator)"

  # Not asked for: not mentioned, not touched.
  up --no-build --no-tunnel
  expect_rc 0
  refute_line "emulator"

  status
  expect_rc 0
  expect_line "emulator running" "$AVD is booted on emulator-5554 (pid $emulator)"
  expect_out "log: .dev-run/emulator.log"

  down
  expect_rc 0
  expect_line "leaf ok" "stopped (pid $leaf)"
  expect_line "emulator skip" "left running (pid $emulator). scripts/dev-down --emulator stops it."
  expect_alive "$emulator" "the emulator"
  expect_file "$RUN/emulator.pid"

  down --emulator
  expect_rc 0
  expect_line "emulator ok" "stopped (pid $emulator)"
  expect_dead "$emulator" "the emulator"
  refute_file "$RUN/emulator.pid"
  expect_nothing_running
}

test_emulator_that_never_boots_is_stopped() {
  sandbox
  with_emulator
  EXTRA_ENV=(STUB_BOOT_AFTER=never LEAF_DEV_WAIT_EMULATOR=1)
  up --no-build --no-tunnel --emulator
