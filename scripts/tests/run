}

test_named_settings_file_must_exist() {
  local other name
  sandbox
  # A second environment's file, misspelt: acting on the default environment
  # instead would stop or start the wrong leaf.
  EXTRA_ENV=("LEAF_DEV_ENV_FILE=$T/no-such.env")
  for name in dev-up dev-status dev-down; do
    script "$name"
    expect_rc 2
    expect_out "there is no settings file at $T/no-such.env. Correct LEAF_DEV_ENV_FILE, or unset it to use scripts/dev.env."
  done
  refute_file "$RUN"
  refute_file "$STATE/leaf.env"

  # One that is there is read instead of scripts/dev.env.
  other=$(free_port)
  printf 'LEAF_DEV_PORT=%s\nLEAF_DEV_DATA_DIR=%s\nLEAF_DEV_RUN_DIR=%s\n' \
    "$other" "$T/data2" "$T/run2" >"$T/second.env"
  EXTRA_ENV=("LEAF_DEV_ENV_FILE=$T/second.env")
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "leaf ok" "setup mode on http://127.0.0.1:$other (pid "
  expect_content "$STATE/leaf.env" "DATA_DIR=$T/data2"
  expect_file "$T/run2/leaf.pid"
  refute_file "$RUN"
  status
  expect_rc 0
  down
  expect_rc 0
  expect_nothing_running
}

test_port_taken_during_the_build_is_not_taken_for_leaf() {
  local squatter
  sandbox
  cp "$STUBS/leaf" "$T/bin/squatter"
  mv "$T/bin/npm" "$T/bin/npm.real"
  # A build during which some other program takes the port dev-up had found
  # free. It is listening before the build ends.
  cat >"$T/bin/npm" <<EOF
#!/usr/bin/env bash
mkfifo "$T/squatter.fifo"
STUB_LEAF=setup BIND_ADDR=127.0.0.1:$PORT STUB_READY_FIFO="$T/squatter.fifo" \\
  "$T/bin/squatter" >/dev/null 2>&1 </dev/null &
echo \$! >"$STATE/squatter.pid"
read -r line <"$T/squatter.fifo"
exec "$T/bin/npm.real" "\$@"
EOF
  chmod +x "$T/bin/npm"
  # The leaf dev-up starts cannot have the port. This one stays up without
  # it, so the only thing answering is the other program.
  EXTRA_ENV=(STUB_LEAF=hang)
  up --no-tunnel
  expect_rc 1
  squatter=$(cat "$STATE/squatter.pid")
  expect_line "gallery ok"
  expect_line "binary ok"
  expect_line "leaf failed" "port $PORT is held by"
  expect_line "leaf failed" "(pid $squatter), which dev-up did not start. It took the port after dev-up found it free, so the leaf dev-up started could not listen there and was stopped. Stop that process yourself, or use another port: scripts/dev-up --port N."
  expect_log_tail_shown leaf
  refute_line "leaf ok"
  refute_out "setup code"
  refute_line "tunnel"
  refute_file "$RUN/leaf.pid"
  refute_file "$RUN/leaf.info"
  # The leaf that never got the port is gone; the other program is untouched.
  expect_alive "$squatter" "the program that took the port"
  [ "$(sandbox_pids | tr '\n' ' ')" = "$squatter " ] ||
    fail "expected only the other program (pid $squatter) to be running, found: $(sandbox_pids | tr '\n' ' ')"
  end_bystander "$squatter"
  expect_nothing_running
}

test_recorded_leaf_without_the_port_is_not_said_to_answer() {
  local stuck squatter
  sandbox
  # A leaf dev-up started that is running but does not have the port, and
  # another program that does: what answers is not dev-up's leaf.
  mkdir -p "$RUN"
  BYSTANDER_ENV=(STUB_LEAF=hang)
  bystander "$REPO/target/debug/leaf"
  stuck=$BYSTANDER
  echo "$stuck" >"$RUN/leaf.pid"
  printf 'sig=%s\nport=%s\ndata=%s\n' "$REPO/target/debug/leaf" "$PORT" "$DATA" >"$RUN/leaf.info"
  cp "$STUBS/leaf" "$T/bin/squatter"
  BYSTANDER_ENV=("BIND_ADDR=127.0.0.1:$PORT")
  bystander "$T/bin/squatter"
  squatter=$BYSTANDER

  status
  expect_rc 1
  expect_line "leaf failed" "running (pid $stuck), but port $PORT is held by"
  expect_out "(pid $squatter), which dev-up did not start"
  refute_line "leaf running"
  expect_out "Next: scripts/dev-down, then scripts/dev-up"

  up --no-build --no-tunnel
  expect_rc 1
  expect_line "leaf failed" "leaf is running (pid $stuck), but port $PORT is held by"
  expect_out "(pid $squatter), which dev-up did not start: what answers on $LOCAL is not this leaf. scripts/dev-down stops this leaf; stop the other process yourself."
  refute_out "already running"
  expect_alive "$stuck" "the leaf without the port"
  expect_alive "$squatter" "the program that has the port"

  down
  expect_rc 0
  expect_line "leaf ok" "stopped (pid $stuck)"
  expect_alive "$squatter" "the program that has the port"
  end_bystander "$squatter"
  expect_nothing_running
}

test_build_asks_cargo_where_it_builds() {
  sandbox
  rm -rf "$REPO/target"
  # A target directory set in a cargo config file: only cargo knows it.
  EXTRA_ENV=("STUB_CARGO_CONFIG_TARGET=$T/configured")
  up --no-tunnel
  expect_rc 0
  expect_line "binary ok" "built $T/configured/debug/leaf"
  expect_content "$STATE/cargo.metadata" "metadata --no-deps --format-version 1"
  refute_file "$REPO/target"
  down
  # --no-build looks in the same place.
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "binary skip" "--no-build: starting $T/configured/debug/leaf"
  down

  # A cargo that cannot say: the environment's two names for it, then ./target.
  EXTRA_ENV=(STUB_CARGO_METADATA=fail "CARGO_BUILD_TARGET_DIR=$T/from-env")
  up --no-tunnel
  expect_rc 0
  expect_line "binary ok" "built $T/from-env/debug/leaf"
  down
  EXTRA_ENV=(STUB_CARGO_METADATA=fail)
  up --no-tunnel
  expect_rc 0
  expect_line "binary ok" "built target/debug/leaf"
  down

  # A build that finishes and leaves no binary where it was looked for is
  # not called a failed build.
  EXTRA_ENV=(STUB_CARGO=nobinary "STUB_CARGO_CONFIG_TARGET=$T/empty")
  up --no-tunnel
  expect_rc 1
  expect_line "binary failed" "cargo build -p leaf finished, but there is no binary at $T/empty/debug/leaf. Set CARGO_TARGET_DIR to the directory cargo builds into, then run scripts/dev-up again."
  refute_out "cargo build -p leaf failed"
  refute_line "leaf"
  refute_file "$RUN/leaf.pid"
  expect_nothing_running
}

# ---------------------------------------------------------------- runner

ALL_TESTS=$(declare -F | sed -n 's/^declare -f \(test_.*\)$/\1/p')

for TEST_NAME in $ALL_TESTS; do
  if [ $# -gt 0 ]; then
    wanted=0
    for word in "$@"; do
      case $TEST_NAME in
      *"$word"*) wanted=1 ;;
      esac
    done
    [ "$wanted" -eq 1 ] || continue
  fi
  TEST_OK=1
  T=
  "$TEST_NAME"
  TESTS_RUN=$((TESTS_RUN + 1))
  case $TEST_OK in
  1) printf 'ok    %s\n' "$TEST_NAME" ;;
  0) TESTS_FAILED=$((TESTS_FAILED + 1)) ;;
  esac
  sweep
done

if [ "$TESTS_RUN" -eq 0 ]; then
  echo "No test matches: $*" >&2
  exit 2
fi
printf '\n%s tests, %s failed.\n' "$TESTS_RUN" "$TESTS_FAILED"
[ "$TESTS_FAILED" -eq 0 ]
