test_tunnel_and_emulator_that_died_later_are_said_and_started_again() {
  local tunnel emulator
  sandbox
  with_tunnel
  with_emulator
  up --no-build --emulator
  expect_rc 0
  tunnel=$(recorded_pid tunnel)
  emulator=$(recorded_pid emulator)
  # Both crash some time after dev-up has gone.
  end_bystander "$tunnel"
  end_bystander "$emulator"

  status
  expect_rc 0
  expect_line "tunnel stopped" "it has exited since dev-up started it. scripts/dev-up starts it again."
  expect_out "log: .dev-run/tunnel.log"
  expect_line "emulator stopped" "it has exited since dev-up started it. scripts/dev-up --emulator boots $AVD again."
  expect_out "log: .dev-run/emulator.log"

  up --no-build --emulator
  expect_rc 0
  expect_line "tunnel ok" "$PUBLIC/setup answers (pid "
  expect_line "emulator ok" "$AVD is booted on emulator-5554 (pid "
  refute_line "tunnel ok already running"
  [ "$(recorded_pid tunnel)" != "$tunnel" ] || fail "the pid of the tunnel that died is still recorded"
  [ "$(recorded_pid emulator)" != "$emulator" ] || fail "the pid of the emulator that died is still recorded"
  down --emulator
  expect_rc 0
  expect_nothing_running
}

test_emulator_from_an_earlier_run_is_waited_for_not_restarted() {
  local emulator
  sandbox
  with_emulator
  up --no-build --no-tunnel --emulator
  expect_rc 0
  emulator=$(recorded_pid emulator)
  rm -f "$STATE/emulator.args"

  # Run again while Android is still booting: the wait ends, the emulator
  # stays, and no second one is started.
  EXTRA_ENV=(STUB_BOOT_AFTER=never LEAF_DEV_WAIT_EMULATOR=1)
  up --no-build --no-tunnel --emulator
  expect_rc 1
  expect_line "emulator failed" "the emulator is running (pid $emulator), but Android has not finished booting after 1s. Run scripts/dev-up --emulator again to keep waiting."
  expect_out "last lines of .dev-run/emulator.log:"
  expect_alive "$emulator" "the emulator"
  [ "$(recorded_pid emulator)" = "$emulator" ] || fail "the emulator (pid $emulator) is no longer recorded"
  refute_file "$STATE/emulator.args"

  status
  expect_line "emulator starting" "$AVD is still booting (pid $emulator)"
  expect_out "log: .dev-run/emulator.log"

  # Asked for another device while that one runs: said, not acted on. (adb
  # lists a booted `other-avd`, which is not the emulator dev-up started.)
  EXTRA_ENV=(LEAF_DEV_AVD=other-avd)
  up --no-build --no-tunnel --emulator
  expect_rc 1
  expect_line "emulator failed" "the emulator dev-up started runs $AVD (pid $emulator), not other-avd. Run scripts/dev-down --emulator first."
  expect_alive "$emulator" "the emulator"
  refute_file "$STATE/emulator.args"

  EXTRA_ENV=()
  down --emulator
  expect_rc 0
  expect_line "emulator ok" "stopped (pid $emulator)"
  expect_nothing_running
}

