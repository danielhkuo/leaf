test_tunnel_settings_that_cannot_work() {
  sandbox
  with_tunnel
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "tunnel skip" "--no-tunnel"
  refute_file "$STATE/cloudflared.args"

  sed -i.bak '/LEAF_DEV_PUBLIC_URL/d' "$REPO/scripts/dev.env"
