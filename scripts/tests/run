test_tunnel_waits_for_the_public_url() {
  local leaf tunnel
  sandbox
  with_tunnel
  # The first three questions get Cloudflare's "no connection" answer.
  EXTRA_ENV=(STUB_TUNNEL_COLD=3)
  up --no-build
  expect_rc 0
  expect_line "leaf ok" "setup mode"
  # leaf is in setup mode, so the address asked is /setup.
  expect_line "tunnel ok" "$PUBLIC/setup answers (pid "
  refute_out "does not mention port"
  expect_content "$STATE/cloudflared.args" "tunnel --config $T/tunnel.yml run stub-tunnel"
  leaf=$(recorded_pid leaf)
  tunnel=$(recorded_pid tunnel)
  expect_alive "$tunnel" "the tunnel"
  expect_file "$RUN/tunnel.log"

  up --no-build
  expect_rc 0
  expect_line "tunnel ok" "already running: $PUBLIC/setup answers (pid $tunnel)"
  [ "$(recorded_pid tunnel)" = "$tunnel" ] || fail "the second run recorded another tunnel pid"
  [ "$(sandbox_pids | wc -l | tr -d ' ')" = 2 ] || fail "expected two processes, found: $(sandbox_pids | tr '\n' ' ')"

  status
  expect_rc 0
  expect_line "tunnel running" "$PUBLIC/setup answers (pid $tunnel)"
  expect_out "log: .dev-run/tunnel.log"

  # --no-tunnel later leaves the running tunnel alone.
  up --no-build --no-tunnel
  expect_rc 0
  expect_line "tunnel skip" "--no-tunnel"
  expect_alive "$tunnel" "the tunnel"

  down
  expect_rc 0
  expect_line "tunnel ok" "stopped (pid $tunnel)"
  expect_line "leaf ok" "stopped (pid $leaf)"
  case $OUT in
  tunnel*leaf*) ;;
  *) fail "expected the tunnel to be stopped before leaf" ;;
  esac
  expect_dead "$tunnel" "the tunnel"
  expect_dead "$leaf" "leaf"
  refute_file "$RUN/tunnel.pid"
  expect_nothing_running
}

test_tunnel_in_run_mode_asks_healthz() {
  sandbox
  with_tunnel
  # No tunnel name: cloudflared takes it from the config.
  sed -i.bak '/LEAF_DEV_TUNNEL_NAME/d' "$REPO/scripts/dev.env"
  # A config that sends the hostname to some other port.
  sed -i.bak "s/localhost:$PORT/localhost:1/" "$T/tunnel.yml"
  EXTRA_ENV=(STUB_LEAF=run)
  up --no-build
  expect_rc 0
  expect_line "tunnel ok" "$PUBLIC/healthz answers (pid "
  expect_out "note: $T/tunnel.yml does not mention port $PORT, so $PUBLIC may not reach this leaf"
  expect_content "$STATE/cloudflared.args" "tunnel --config $T/tunnel.yml run"
  [ "$(cat "$STATE/cloudflared.args")" = "tunnel --config $T/tunnel.yml run" ] ||
    fail "expected no tunnel name in: $(cat "$STATE/cloudflared.args")"
  status
  expect_line "tunnel running" "$PUBLIC/healthz answers"
  down
  expect_nothing_running
}

