  down --emulator
  expect_rc 0
  expect_line "emulator ok" "nothing to stop"
  expect_out "an emulator that dev-up did not start runs $AVD (pid $other): left alone"
  expect_alive "$other" "the emulator started by hand"
  end_bystander "$other"
