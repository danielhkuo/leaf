# Nothing here is required. Copy this file to `.env` only to override a default.

# Discord application (client) id. Inside Discord the gallery reads the id from
# its own `<id>.discordsays.com` address, and that always wins. This value is
# used only when the page is served from some other host.
# VITE_DISCORD_CLIENT_ID=

# Override the API base. Defaults to same-origin `/api`, which the Vite dev
# proxy (and Discord's proxy in production) routes to leaf-server.
# VITE_API_BASE=/api
